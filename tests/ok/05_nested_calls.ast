program
  fn double(i32 x) -> i32
    block
      decl d i32 const
        binop +
          var x
          var x
      exit
        var d
  fn add(i32 a, i32 b) -> i32
    block
      decl s i32 const
        binop +
          var a
          var b
      exit
        var s
  decl res i32 const
    call add
      call double
        const 3
      call double
        const 4
  exit
    var res
